generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//PLANTILLA DE LA FICHA DE CADA USUARIO
model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  username String?
  name     String?
  posts    Post[]

  @@map("users")
}

model Post {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  content  String?
  author   User    @relation(fields: [authorId], references: [id])
  authorId String  @db.ObjectId

  @@map("posts")
}

model Producto {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  nombre   String  
  tipo    String
  color   String?
  modelo  String
  precio  Float

  @@map("productos")
}

model Servicio {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  nombre   String  
  precio  Float

  @@map("servicios")
}